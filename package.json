{
  "name": "vote-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "prepare:gis": "node scripts/prepare-geography.mjs",
    "prepare:places": "node scripts/prepare-places.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@turf/point-on-feature": "^7.4.0",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "description": "South African local election maps, party results and council seats.",
  "engines": {
    "node": ">=24"
  }
